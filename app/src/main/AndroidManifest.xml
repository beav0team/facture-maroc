<?xml version="1.0" encoding="utf-8"?>
<!--
    One permission, and it is optional: the camera, used only to read the
    barcode off a box into the article's code field.

    Everything else needs nothing. The app never touches the network. Invoice
    PDFs are written to the app's own cache directory and shared through the
    FileProvider below, which hands out a content:// URI that the receiving app
    is granted read access to through the intent itself. A shop logo is picked
    with the same per-file grant from the photo picker. Sharing a document the
    app made is not the same permission as reading the user's files, and this
    app does not ask for the second one.

    The camera feature is declared not required so the app still installs on a
    device without one; the scanner is a shortcut for typing, and typing still
    works.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Two permissions nobody asked for, which the build had been carrying
        silently: ML Kit's own manifest pulls in com.google.android.datatransport
        (transport-runtime and transport-backend-cct), whose whole job is
        uploading usage logs to Google, and it declares INTERNET and
        ACCESS_NETWORK_STATE to do it.

        That directly contradicts what this app promises and what the Play
        listing says: it works offline and nothing leaves the phone. The barcode
        model is the bundled one, so recognition is entirely on the device and
        needs neither permission. Removing them is therefore a correction, not a
        sacrifice — and it is the only way the "no data collected" answer in the
        Data safety form is literally true.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FactureMaroc">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
