<?xml version="1.0" encoding="utf-8"?>
<!--
    No permissions are declared on purpose.

    The app never touches the network. Invoice PDFs are written to the app's
    own cache directory and shared through the FileProvider below, which hands
    out a content:// URI that the receiving app is granted read access to
    through the intent itself. A shop logo is picked with the same per-file
    grant from the photo picker, so that needs nothing either. Sharing a
    document the app made is not the same permission as reading the user's
    files, and this app does not ask for the second one.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FactureMaroc">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
