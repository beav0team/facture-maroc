<?xml version="1.0" encoding="utf-8"?>
<!--
    Backs up everything the app writes to its own files directory:

    filesDir/invoices.json    - every document, draft or issued
    filesDir/saved_items.json - the shop's own items and services
    filesDir/shop_logo.png    - the logo picked from the photo picker

    Shared preferences are backed up automatically when this file is set,
    which covers the shop's identity, the clients and the invoice counters.

    Nothing in cache/ is backed up: a generated PDF can be rendered again
    from the record, and the cache is cleared on uninstall anyway.
-->
<full-backup-content>
    <include domain="file" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
