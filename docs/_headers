# Cloudflare Pages _headers — sécurité et cache

# Pages HTML : pas de cache long, pas d'indexation pour l'app SPA
/app/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cache-Control: public, max-age=0, must-revalidate

# Bundle de l'app : Vite hache les noms de fichier, le cache long est sûr
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Manifest, favicon : cache long
/app/manifest.webmanifest
  Cache-Control: public, max-age=31536000, immutable

/app/icons/*
  Cache-Control: public, max-age=31536000, immutable

# CSS de la vitrine : docs/build.py estampille un ?v=<empreinte> sur chaque
# page, donc l'URL change quand le fichier change — cache long légitime.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Polices : stables, jamais renommées.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Images de la vitrine : remplacées sans changer de nom (captures de compte,
# maquettes de modèles). Pas de cache immuable, sinon une image corrigée reste
# un an dans le navigateur d'un visiteur déjà venu.
/assets/img/*
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

# HSTS forcé (Cloudflare l'active aussi côté edge)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
